# DevInit experiments: run the training firmware, stop after the PMU run
# (success or failure) and print the host-side phypara/ACSM/message dump.
CONFIG_K3_DDR_LPDDR4X=n
CONFIG_K3_DDR_LP5_FREE_FW=y
CONFIG_K3_DDR_LP5_FREE_FW_PREFIX="../SpacemiT_K3_DDR/build/train/train"
CONFIG_K3_DDR_PMU_MBOX_LOG=y
CONFIG_K3_DDR_PMU_MBOX_TIMEOUT_MS=10000
CONFIG_K3_DDR_PMU_STOP_AFTER_FW=y
CONFIG_K3_DDR_PMU_HOST_DUMP=y
