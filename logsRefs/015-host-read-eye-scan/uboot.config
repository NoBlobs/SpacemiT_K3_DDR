# Experiment 015: as 013 (host-assisted quickboot, envelope E1), then a read-eye scan
# from the host (0x01<byte><bit>4e/4f), memory test again, halt.
CONFIG_K3_DDR_LPDDR4X=n
CONFIG_K3_DDR_LP5_FREE_FW=y
CONFIG_K3_DDR_LP5_FREE_FW_PREFIX="../SpacemiT_K3_DDR/build/train/train"
CONFIG_K3_DDR_PMU_MBOX_LOG=y
CONFIG_K3_DDR_PMU_MBOX_TIMEOUT_MS=10000
# CONFIG_K3_DDR_PMU_STOP_AFTER_FW is not set
CONFIG_K3_DDR_REF_ENVELOPE=y
CONFIG_K3_DDR_REF_ENVELOPE_PATH="/home/thalles/0-git/NoBlobs/SpacemiT_K3_DDR/build/envelope/ref6400-fdl-e1.bin"
CONFIG_K3_DDR_REF_QUICKBOOT=y
CONFIG_K3_DDR_REF_EYESCAN=y
